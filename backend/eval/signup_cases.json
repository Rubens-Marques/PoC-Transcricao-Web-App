{
  "_readme": [
    "Evaluation set for signup answer interpretation.",
    "Each case lists only the fields the answer actually expresses.",
    "'strict_null' lists fields that MUST come back null.",
    "A list value means 'any of these is acceptable'.",
    "'tag' groups cases by difficulty for the report."
  ],
  "cases": [
    {
      "tag": "name",
      "field": "name",
      "text": "Maria Aparecida Silva",
      "expected": { "full_name": "Maria Aparecida Silva" }
    },
    {
      "tag": "name",
      "field": "name",
      "text": "hi, my name is Maria Silva",
      "expected": { "full_name": "Maria Silva" }
    },
    {
      "tag": "name",
      "field": "name",
      "text": "you can call me Joe",
      "expected": { "full_name": null },
      "strict_null": ["full_name"]
    },
    {
      "tag": "name",
      "field": "name",
      "text": "I am Mrs. Cleusa",
      "expected": { "full_name": null },
      "strict_null": ["full_name"]
    },

    {
      "tag": "email",
      "field": "email",
      "text": "maria.silva@uol.com.br",
      "expected": { "email": "maria.silva@uol.com.br" }
    },
    {
      "tag": "email-voice",
      "field": "email",
      "text": "maria at gmail dot com",
      "expected": { "email": "maria@gmail.com" }
    },
    {
      "tag": "email-voice",
      "field": "email",
      "text": "it is john silva at hotmail dot com",
      "expected": {
        "email": ["johnsilva@hotmail.com", "john.silva@hotmail.com"]
      }
    },

    {
      "tag": "date",
      "field": "birthDate",
      "text": "03/15/1952",
      "expected": { "birth_date": "1952-03-15" }
    },
    {
      "tag": "date",
      "field": "birthDate",
      "text": "I was born on March 15, 1952",
      "expected": { "birth_date": "1952-03-15" }
    },
    {
      "tag": "date",
      "field": "birthDate",
      "text": "January 1, 1948",
      "expected": { "birth_date": "1948-01-01" }
    },
    {
      "tag": "age",
      "field": "birthDate",
      "text": "I am 71 years old",
      "expected": { "age": 71 },
      "strict_null": ["birth_date"]
    },
    {
      "tag": "age",
      "field": "birthDate",
      "text": "I just turned 68",
      "expected": { "age": 68 },
      "strict_null": ["birth_date"]
    },

    {
      "tag": "marital-direct",
      "field": "maritalStatus",
      "text": "single",
      "expected": { "marital_status": "single" }
    },
    {
      "tag": "marital-slang",
      "field": "maritalStatus",
      "text": "I am single",
      "expected": { "marital_status": "single" }
    },
    {
      "tag": "marital-slang",
      "field": "maritalStatus",
      "text": "never married",
      "expected": { "marital_status": "single" }
    },
    {
      "tag": "marital-context",
      "field": "maritalStatus",
      "text": "married for 20 years",
      "expected": { "marital_status": "married" }
    },
    {
      "tag": "marital-context",
      "field": "maritalStatus",
      "text": "I have been married to Joaquim since 1978",
      "expected": { "marital_status": "married" }
    },
    {
      "tag": "marital-context",
      "field": "maritalStatus",
      "text": "I have been a widow since 2010",
      "expected": { "marital_status": "widowed" }
    },
    {
      "tag": "marital-context",
      "field": "maritalStatus",
      "text": "I lost my husband three years ago",
      "expected": { "marital_status": "widowed" }
    },
    {
      "tag": "marital-slang",
      "field": "maritalStatus",
      "text": "we live together",
      "expected": { "marital_status": "partnership" }
    },
    {
      "tag": "marital-slang",
      "field": "maritalStatus",
      "text": "I separated a while ago",
      "expected": { "marital_status": "divorced" }
    },
    {
      "tag": "marital-empty",
      "field": "maritalStatus",
      "text": "I would rather not say",
      "strict_null": ["marital_status"]
    },

    {
      "tag": "children",
      "field": "children",
      "text": "I do not",
      "expected": { "has_minor_children": false, "minor_children_count": 0 }
    },
    {
      "tag": "children",
      "field": "children",
      "text": "I have two little ones",
      "expected": { "has_minor_children": true, "minor_children_count": 2 }
    },
    {
      "tag": "children",
      "field": "children",
      "text": "yes, 3",
      "expected": { "has_minor_children": true, "minor_children_count": 3 }
    },
    {
      "tag": "children-trap",
      "field": "children",
      "text": "I have two children but they are grown",
      "expected": { "has_minor_children": false, "minor_children_count": 0 }
    },
    {
      "tag": "children-trap",
      "field": "children",
      "text": "my children are all married now",
      "expected": { "has_minor_children": false, "minor_children_count": 0 }
    },

    {
      "tag": "place",
      "field": "place",
      "text": "I live in Campinas, São Paulo",
      "expected": { "city": "Campinas", "state": "São Paulo" }
    },
    {
      "tag": "place",
      "field": "place",
      "text": "I am from Austin, Texas",
      "expected": { "city": "Austin", "state": "Texas" }
    },
    {
      "tag": "place",
      "field": "place",
      "text": "here in Recife",
      "expected": { "city": "Recife" }
    },

    {
      "tag": "hobbies",
      "field": "hobbies",
      "text": "I like walking, photography, and cooking",
      "expected": { "hobbies_min": 3 }
    },
    {
      "tag": "hobbies",
      "field": "hobbies",
      "text": "I love taking care of my garden",
      "expected": { "hobbies_min": 1 }
    },
    {
      "tag": "hobbies",
      "field": "hobbies",
      "text": "I dance and play cards with friends",
      "expected": { "hobbies_min": 2 }
    }
  ]
}
