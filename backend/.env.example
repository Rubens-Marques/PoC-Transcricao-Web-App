# Copy to backend/.env and fill in. Never commit the real .env.

# Which engine turns the sentence into structured preferences.
#   ollama    — a small instruct model on THIS machine. Nothing leaves the host.
#   anthropic — the hosted Messages API. Requires LLM_API_KEY.
#   mock      — keyword matching, for offline tests. Not a fallback.
LLM_PROVIDER=ollama

# --- ollama ------------------------------------------------------------------
# Setup:  brew install ollama && ollama serve && ollama pull qwen2.5:3b
# ~1.9 GB on disk, ~2.5 GB resident while answering.
OLLAMA_HOST=http://localhost:11434

# --- anthropic ---------------------------------------------------------------
# Only read when LLM_PROVIDER=anthropic.
LLM_API_KEY=

# Optional. Overrides the model for whichever provider is active.
# Defaults: qwen2.5:3b (ollama) / claude-opus-5 (anthropic).
# WARNING: an Ollama model whose name ends in "-cloud" runs on Ollama's servers,
# not on this machine. Do not use one here if local-only is the point.
LLM_MODEL=

# Optional. Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Optional. Defaults to backend/data/travel.db.
DATABASE_PATH=

# Optional. DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
