# Copy to backend/.env and fill in. Never commit the real .env.

# "anthropic" calls the external LLM API.
# "mock" uses local keyword matching so the PoC runs end-to-end without a key.
LLM_PROVIDER=anthropic

# API key for the provider above. Required when LLM_PROVIDER=anthropic.
LLM_API_KEY=

# Optional. Defaults to claude-opus-5.
LLM_MODEL=claude-opus-5

# Optional. Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Optional. Defaults to backend/data/travel.db.
DATABASE_PATH=

# Optional. DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
